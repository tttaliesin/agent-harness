{
  "schema": 1,
  "mise_version": "2026.8.10",
  "tools": {},
  "modules": [
    {
      "name": "cli",
      "kind": "rust",
      "path": ".",
      "commands": {
        "lint": [
          "cargo fmt --all -- --check",
          "cargo clippy --locked --all-targets -- -D warnings"
