{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "adapter": {
      "enum": [
        "local-v1",
        "codex-desktop"
      ]
    },
    "event": {
      "enum": [
        "SessionStart",
        "Stop",
        "SubagentStop",
        "Interrupt"
      ]
    },
    "event_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
    },
    "change_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
    },
    "stop_hook_active": {
      "type": "boolean"
    },
    "interrupted": {
      "type": "boolean"
    },
    "repair_round": {
      "type": "integer",
      "minimum": 0
    },
    "budget_remaining": {
      "type": "integer",
      "minimum": 0
    },
    "state": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_RUN",
        "NOT_APPLICABLE"
      ]
    },
    "unresolved_findings": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter",
    "event",
    "event_id",
    "change_id",
    "stop_hook_active",
    "interrupted",
    "repair_round",
    "budget_remaining",
    "state",
    "unresolved_findings"
  ]
}
